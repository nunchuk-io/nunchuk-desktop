# syntax=docker/dockerfile:1.7
FROM ubuntu:24.04@sha256:d78ab76437b1afc5f01e223d6bf0172763f404bb166441328845adbef44518cb

ARG QT_VERSION=5.15.2
ARG AQTINSTALL_VERSION=3.3.0

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    QT_INSTALL_DIR=/opt/Qt \
    QT_VERSION=${QT_VERSION} \
    UBUNTU_SNAPSHOT=20260818T000000Z \
    QT5_DIR=/opt/Qt/${QT_VERSION}/gcc_64/lib/cmake/Qt5 \
    QT_INSTALLED_PREFIX=/opt/Qt/${QT_VERSION}/gcc_64 \
    OPENSSL_ROOT_DIR=/opt/openssl-1.1.1w \
    DEPENDENCY_SOURCE_DATE_EPOCH=1588032000 \
    ZERO_AR_DATE=1 \
    ARFLAGS=crD \
    CC=gcc-14 \
    CXX=g++-14 \
    AR=gcc-ar-14 \
    RANLIB=gcc-ranlib-14 \
    NM=gcc-nm-14

# The pinned Ubuntu OCI rootfs contains ubuntu-keyring but no CA bundle or
# openssl CLI. Bootstrap both from the same snapshot with BuildKit-enforced
# checksums before APT connects to snapshot.ubuntu.com over HTTPS.
ADD --checksum=sha256:321b30ad5a1c3783cb3d73ae439f824f6d3874d76a93a62f4a984959b490aa7b \
    https://snapshot.ubuntu.com/ubuntu/20260818T000000Z/pool/main/o/openssl/openssl_3.0.13-0ubuntu3.12_amd64.deb \
    /tmp/openssl-bootstrap.deb
ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 \
    https://snapshot.ubuntu.com/ubuntu/20260818T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb \
    /tmp/ca-certificates-bootstrap.deb
RUN dpkg -i /tmp/openssl-bootstrap.deb /tmp/ca-certificates-bootstrap.deb && \
    rm -f /tmp/openssl-bootstrap.deb /tmp/ca-certificates-bootstrap.deb

# Freeze Ubuntu packages at one archive snapshot. Use the snapshot URL
# directly instead of relying on mirror metadata to resolve APT::Snapshot.
# Old snapshots intentionally need Valid-Until disabled so the same package
# indexes remain usable when the release is reproduced months or years later.
RUN printf '%s\n' \
        'Types: deb' \
        "URIs: https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/" \
        'Suites: noble noble-updates noble-backports noble-security' \
        'Components: main universe restricted multiverse' \
        'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/ubuntu.sources && \
    rm -f /etc/apt/sources.list /etc/apt/apt.conf.d/50nunchuk-snapshot && \
    apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        binutils ca-certificates cmake curl dbus-x11 desktop-file-utils \
        dpkg-dev file g++-14 gcc-14 git libboost-all-dev libdb++-dev \
        libdbus-1-dev libegl1 libevent-dev libgl-dev libglu1-mesa-dev \
        libgstreamer-plugins-bad1.0-0 libgstreamer-plugins-base1.0-0 \
        libgstreamer1.0-0 libnss3 libnss3-dev libpulse-dev libsecret-1-dev \
        libsqlite3-dev libx11-xcb1 libxcb-cursor0 libxcb-glx0 libxcb-icccm4 \
        libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
        libxcb-render0 libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-util1 \
        libxcb-xfixes0 libxcb-xinerama0 libxcb-xinput0 libxcb-xkb1 \
        libxkbcommon-x11-0 libxkbcommon0 libzmq3-dev make ninja-build \
        patchelf python3-pip sqlite3 unzip wget xvfb zip && \
    rm -rf /var/lib/apt/lists/* && \
    git config --system --add safe.directory /project && \
    git config --system --add safe.directory '/project/*'

RUN pip3 install --break-system-packages --no-cache-dir \
        "aqtinstall==${AQTINSTALL_VERSION}" && \
    aqt install-qt linux desktop "$QT_VERSION" gcc_64 \
        --outputdir "$QT_INSTALL_DIR" && \
    aqt install-qt linux desktop "$QT_VERSION" gcc_64 \
        --outputdir "$QT_INSTALL_DIR" \
        --modules qtcharts qtdatavis3d qtlottie qtnetworkauth qtpurchasing \
                  qtquick3d qtquicktimeline qtscript qtvirtualkeyboard \
                  qtwaylandcompositor qtwebengine qtwebglplugin

ARG QTKEYCHAIN_COMMIT=ad7344c45a86a4f66cbafc4b081b5f7b876cb0b7
RUN export SOURCE_DATE_EPOCH="$DEPENDENCY_SOURCE_DATE_EPOCH" && \
    git clone https://github.com/frankosterfeld/qtkeychain.git /tmp/qtkeychain && \
    cd /tmp/qtkeychain && \
    git checkout --detach "$QTKEYCHAIN_COMMIT" && \
    test "$(git rev-parse HEAD)" = "$QTKEYCHAIN_COMMIT" && \
    cmake -S . -B build -G Ninja \
        -DBUILD_WITH_QT5=ON \
        -DBUILD_TESTING=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DQt5_DIR="$QT5_DIR" && \
    cmake --build build --parallel 4 && \
    cmake --install build && \
    rm -rf /tmp/qtkeychain

ARG OLM_COMMIT=7e0c8277032e40308987257b711b38af8d77cc69
RUN export SOURCE_DATE_EPOCH="$DEPENDENCY_SOURCE_DATE_EPOCH" && \
    git clone https://gitlab.matrix.org/matrix-org/olm.git /tmp/olm && \
    cd /tmp/olm && \
    git checkout --detach "$OLM_COMMIT" && \
    test "$(git rev-parse HEAD)" = "$OLM_COMMIT" && \
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && \
    cmake --build build --parallel 4 && \
    cmake --install build && \
    rm -rf /tmp/olm && \
    ldconfig

ARG CQTDEPLOYER_URL=https://github.com/QuasarApp/CQtDeployer/releases/download/v1.6.2365/CQtDeployer_1.6.2365.7cce7f3_Linux_x86_64.deb
ARG CQTDEPLOYER_SHA256=a183850a0814e80cc184dea52e4123fcd7826d439c98ab2a20924e07a1b67298
RUN curl --fail --location --retry 5 --output /tmp/cqtdeployer.deb \
        "$CQTDEPLOYER_URL" && \
    printf '%s  %s\n' "$CQTDEPLOYER_SHA256" /tmp/cqtdeployer.deb \
        | sha256sum --check --strict && \
    dpkg -i /tmp/cqtdeployer.deb && \
    rm /tmp/cqtdeployer.deb

ARG OPENSSL_URL=https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz
ARG OPENSSL_SHA256=cf3098950cb4d853ad95c0841f1f9c6d3dc102dccfcacd521d93925208b76ac8
RUN export SOURCE_DATE_EPOCH="$DEPENDENCY_SOURCE_DATE_EPOCH" && \
    curl --fail --location --retry 5 --output /tmp/openssl.tar.gz \
        "$OPENSSL_URL" && \
    printf '%s  %s\n' "$OPENSSL_SHA256" /tmp/openssl.tar.gz \
        | sha256sum --check --strict && \
    mkdir /tmp/openssl && \
    tar -xzf /tmp/openssl.tar.gz -C /tmp/openssl --strip-components=1 && \
    cd /tmp/openssl && \
    ./config --prefix="$OPENSSL_ROOT_DIR" && \
    make -j4 && \
    make install_dev && \
    rm -rf /tmp/openssl /tmp/openssl.tar.gz

ARG APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
ARG APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
ARG APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
ARG APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
RUN curl --fail --location --retry 5 --output /usr/local/bin/appimagetool \
        "$APPIMAGETOOL_URL" && \
    curl --fail --location --retry 5 --output /usr/local/lib/appimage-runtime-x86_64 \
        "$APPIMAGE_RUNTIME_URL" && \
    printf '%s  %s\n' "$APPIMAGETOOL_SHA256" /usr/local/bin/appimagetool \
        | sha256sum --check --strict && \
    printf '%s  %s\n' "$APPIMAGE_RUNTIME_SHA256" /usr/local/lib/appimage-runtime-x86_64 \
        | sha256sum --check --strict && \
    chmod 0755 /usr/local/bin/appimagetool /usr/local/lib/appimage-runtime-x86_64

WORKDIR /project
CMD ["bash", "/project/reproducible-builds/build_linux.sh"]
