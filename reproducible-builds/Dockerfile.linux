# Multi-architecture Ubuntu 24.04 index, recorded on 2026-10-09.
# Update the base digest and snapshot deliberately for future releases.
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ARG TARGETARCH

# Docker's --platform selects the matching Qt archives and HWI binary.
FROM ${UBUNTU_IMAGE} AS platform-amd64
ENV ARCH=x86_64 QT_HOST=linux QT_ARCH=linux_gcc_64 QT_DIR_NAME=gcc_64

FROM ${UBUNTU_IMAGE} AS platform-arm64
ENV ARCH=aarch64 QT_HOST=linux_arm64 QT_ARCH=linux_gcc_arm64 QT_DIR_NAME=gcc_arm64

FROM platform-${TARGETARCH} AS builder
ARG UBUNTU_IMAGE
ARG UBUNTU_SNAPSHOT=20261008T000000Z

ARG QT_VERSION=6.9.3
# GCC comes from the same frozen Ubuntu archive as its dependencies, with
# no live PPA. This version is available for both amd64 and arm64.
ARG GCC14_VERSION=14.2.0-4ubuntu2~24.04.1
ARG AQT_VERSION=3.3.0
ARG QTKEYCHAIN_VERSION=0.15.0
ARG QTKEYCHAIN_COMMIT=ad7344c45a86a4f66cbafc4b081b5f7b876cb0b7
ARG OLM_VERSION=3.2.16
ARG OLM_COMMIT=7e0c8277032e40308987257b711b38af8d77cc69
# Use numbered releases and archive checksums; never the moving continuous tag.
ARG LINUXDEPLOY_VERSION=1-alpha-20251107-1
# linuxdeploy: cc7b86472c3caa3fd729b9dc502fd2aa78394257.
# Checksums from GitHub release metadata (2026-09-08).
ARG LINUXDEPLOY_SHA256_X86_64=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d
# Linux aarch64 archive.
ARG LINUXDEPLOY_SHA256_AARCH64=620095110d693282b8ebeb244a95b5e911cf8f65f76c88b4b47d16ae6346fcff
# linuxdeploy-plugin-qt: ce5291e25979d7d6417551d787f308b88c1b8d76.
ARG LINUXDEPLOY_QT_VERSION=1-alpha-20250213-1
# Archive checksums recorded on 2026-09-08.
ARG LINUXDEPLOY_QT_SHA256_X86_64=15106be885c1c48a021198e7e1e9a48ce9d02a86dd0a1848f00bdbf3c1c92724
# Linux aarch64 archive.
ARG LINUXDEPLOY_QT_SHA256_AARCH64=bf1c24aff6d749b5cf423afad6f15abd4440f81dec1aab95706b25f6667cdcf1
# linuxdeploy-plugin-appimage: a96502d15ce19ec1df3d46e6cbe87ddf38589a71.
# Archive checksums recorded on 2026-09-08.
ARG LINUXDEPLOY_PLUGIN_APPIMAGE_VERSION=1-alpha-20250213-1
ARG LINUXDEPLOY_PLUGIN_APPIMAGE_SHA256_X86_64=992d502a248e14ab185448ddf6f6e7d25558cb84d4623c354c3af350c25fccb3
ARG LINUXDEPLOY_PLUGIN_APPIMAGE_SHA256_AARCH64=83c292149274965a865dcd44c135cfca8ba28c6b7de3eb628d4b8b5f248af17c
ARG APPIMAGE_RUNTIME_VERSION=20251108
# Per-arch checksums for the runtime binary declared just before its RUN step
# below (kept there, next to its usage, rather than duplicated here).
ARG BUILDER_SOURCE_DATE_EPOCH=1780963200

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    SOURCE_DATE_EPOCH=${BUILDER_SOURCE_DATE_EPOCH} \
    ZERO_AR_DATE=1 \
    QT_INSTALL_DIR=/opt/Qt \
    QT_VERSION=${QT_VERSION} \
    QT_INSTALLED_PREFIX=/opt/Qt/${QT_VERSION}/${QT_DIR_NAME} \
    QT6_DIR=/opt/Qt/${QT_VERSION}/${QT_DIR_NAME}/lib/cmake/Qt6 \
    APPIMAGE_RUNTIME_FILE=/usr/local/lib/appimage-runtime

ENV PATH=${QT_INSTALLED_PREFIX}/bin:${PATH} \
    CC=/usr/bin/gcc-14 \
    CXX=/usr/bin/g++-14 \
    AR=/usr/bin/gcc-ar-14 \
    NM=/usr/bin/gcc-nm-14 \
    RANLIB=/usr/bin/gcc-ranlib-14 \
    APPIMAGE_EXTRACT_AND_RUN=1

# The minimal base has no CA roots, and the snapshot service requires HTTPS.
# BuildKit downloads this pinned package before APT needs certificate trust.
ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 \
    https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb \
    /tmp/ca-certificates.deb
RUN dpkg-deb --extract /tmp/ca-certificates.deb /tmp/ca-certificates \
    && mkdir -p /etc/ssl/certs \
    && cat /tmp/ca-certificates/usr/share/ca-certificates/mozilla/*.crt > /etc/ssl/certs/ca-certificates.crt \
    && rm -rf /tmp/ca-certificates /tmp/ca-certificates.deb

# Freeze the complete dependency closure, including libraries bundled into
# the AppImage. Signature verification stays enabled; only freshness expiry
# is disabled for this deliberately historical archive. The snapshot serves
# both amd64 and arm64, replacing the base image's archive/ports sources.
RUN printf '%s\n' \
        'Types: deb' \
        "URIs: https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/" \
        'Suites: noble noble-updates noble-security' \
        'Components: main restricted universe multiverse' \
        'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        curl \
        desktop-file-utils \
        dpkg-dev \
        file \
        fuse \
        g++ \
        git \
        libasound2-dev \
        libboost-all-dev \
        libcom-err2 \
        libdb++-dev \
        libdbus-1-dev \
        libegl1-mesa-dev \
        libevent-dev \
        libexpat1 \
        libfontconfig1 \
        libfreetype6 \
        libfribidi0 \
        libfuse2 \
        libgbm1 \
        libgl1-mesa-dev \
        libgl1-mesa-dri \
        libglu1-mesa-dev \
        libgpg-error0 \
        libharfbuzz0b \
        liblcms2-2 \
        libminizip-dev \
        libnss3-dev \
        libpulse-dev \
        libsecret-1-dev \
        libsnappy1v5 \
        libsqlite3-dev \
        libssl-dev \
        libudev-dev \
        libusb-1.0-0-dev \
        libwebp7 \
        libwebpdemux2 \
        libwebpmux3 \
        libx11-xcb-dev \
        libxcomposite-dev \
        libxcursor-dev \
        libxdamage-dev \
        libxi-dev \
        libxkbcommon-x11-0 \
        libxkbfile1 \
        libxrandr-dev \
        libxss-dev \
        libxt-dev \
        libxtst-dev \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-sync1 \
        libxcb-util1 \
        libxcb-xfixes0 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libzmq3-dev \
        make \
        mesa-common-dev \
        ninja-build \
        openssl \
        p7zip-full \
        patchelf \
        python3-pip \
        sqlite3 \
        squashfuse \
        unzip \
        wget \
    && apt-get install -y --no-install-recommends "gcc-14=${GCC14_VERSION}" "g++-14=${GCC14_VERSION}" \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 100 \
    && rm -rf /var/lib/apt/lists/*

COPY reproducible-builds/qt-6.9.3-linux-*.sha256 /opt/qt-checksums/
RUN python3 -m pip install --break-system-packages --no-cache-dir "aqtinstall==${AQT_VERSION}" \
    && aqt install-qt "${QT_HOST}" desktop "${QT_VERSION}" "${QT_ARCH}" \
        --outputdir "${QT_INSTALL_DIR}" \
        --keep --archive-dest /tmp/qt-archives \
        --modules \
            qt5compat \
            qtmultimedia \
            qtnetworkauth \
            qtpositioning \
            qtshadertools \
            qtwebchannel \
            qtwebengine \
    && cd /tmp/qt-archives \
    && sha256sum --check --strict "/opt/qt-checksums/qt-${QT_VERSION}-linux-${ARCH}.sha256" \
    && find . -maxdepth 1 -type f -printf '%f\n' | LC_ALL=C sort > /tmp/qt-actual-archives.txt \
    && awk '!/^#/ && NF { print $2 }' "/opt/qt-checksums/qt-${QT_VERSION}-linux-${ARCH}.sha256" \
        | LC_ALL=C sort > /tmp/qt-expected-archives.txt \
    && diff -u /tmp/qt-expected-archives.txt /tmp/qt-actual-archives.txt \
    && rm -f /tmp/qt-actual-archives.txt /tmp/qt-expected-archives.txt \
    && rm -rf /tmp/qt-archives

# Fail while creating the builder image when the Qt archive is internally
# incomplete or linked against an incompatible host minizip/XCB runtime. These
# are the two most common late failures for Qt WebEngine AppImages.
RUN set -eux; \
    qmake_path="$(command -v qmake6 || command -v qmake)"; \
    qt_qml_path="$(${qmake_path} -query QT_INSTALL_QML)"; \
    shader_tools="${QT_INSTALLED_PREFIX}/lib/libQt6ShaderTools.so.6"; \
    graphical_effects="${qt_qml_path}/Qt5Compat/GraphicalEffects/private/libqtgraphicaleffectsprivateplugin.so"; \
    webengine_core="$(find "${QT_INSTALLED_PREFIX}/lib" -maxdepth 1 -type f -name 'libQt6WebEngineCore.so.*' -print -quit)"; \
    qxcb_plugin="${QT_INSTALLED_PREFIX}/plugins/platforms/libqxcb.so"; \
    test -e "${shader_tools}"; \
    test -f "${graphical_effects}"; \
    test -n "${webengine_core}"; \
    test -f "${qxcb_plugin}"; \
    file -L "${webengine_core}" "${qxcb_plugin}"; \
    for qt_library in "${graphical_effects}" "${webengine_core}" "${qxcb_plugin}"; do \
        dependencies="$(LD_LIBRARY_PATH="${QT_INSTALLED_PREFIX}/lib" ldd "${qt_library}")"; \
        if printf '%s\n' "${dependencies}" | grep 'not found'; then exit 1; fi; \
    done; \
    minizip_library="$(ldconfig -p | awk '$1 == "libminizip.so.1" { print $NF }' | sort -u)"; \
    test "$(printf '%s\n' "${minizip_library}" | sed '/^$/d' | wc -l)" -eq 1; \
    test -f "${minizip_library}"; \
    ${NM} -D --defined-only "${minizip_library}" | awk '{ sub(/@.*/, "", $3); print $3 }' > /tmp/minizip-symbols; \
    for symbol in fill_fopen64_filefunc zipWriteInFileInZip zipOpenNewFileInZip4_64 zipOpen2_64 zipClose zipCloseFileInZip; do \
        grep -qx "${symbol}" /tmp/minizip-symbols; \
    done; \
    rm /tmp/minizip-symbols

RUN git clone --branch "${QTKEYCHAIN_VERSION}" --depth 1 https://github.com/frankosterfeld/qtkeychain.git /tmp/qtkeychain \
    && test "$(git -C /tmp/qtkeychain rev-parse HEAD)" = "${QTKEYCHAIN_COMMIT}" \
    && cmake -S /tmp/qtkeychain -B /tmp/qtkeychain-build -G Ninja \
        -DBUILD_WITH_QT6=ON \
        -DBUILD_TESTING=OFF \
        -DBUILD_TEST_APPLICATION=OFF \
        -DBUILD_TRANSLATIONS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_PREFIX_PATH="${QT_INSTALLED_PREFIX}" \
        -DQt6_DIR="${QT6_DIR}" \
    && cmake --build /tmp/qtkeychain-build \
    && cmake --install /tmp/qtkeychain-build \
    && ldconfig \
    && rm -rf /tmp/qtkeychain /tmp/qtkeychain-build

RUN git clone --branch "${OLM_VERSION}" --depth 1 https://gitlab.matrix.org/matrix-org/olm.git /tmp/olm \
    && test "$(git -C /tmp/olm rev-parse HEAD)" = "${OLM_COMMIT}" \
    && cmake -S /tmp/olm -B /tmp/olm-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /tmp/olm-build \
    && cmake --install /tmp/olm-build \
    && ldconfig \
    && rm -rf /tmp/olm /tmp/olm-build

RUN set -eux; \
    case "${ARCH}" in \
        x86_64)  linuxdeploy_sha256="${LINUXDEPLOY_SHA256_X86_64}";  linuxdeploy_qt_sha256="${LINUXDEPLOY_QT_SHA256_X86_64}";  linuxdeploy_plugin_appimage_sha256="${LINUXDEPLOY_PLUGIN_APPIMAGE_SHA256_X86_64}" ;; \
        aarch64) linuxdeploy_sha256="${LINUXDEPLOY_SHA256_AARCH64}"; linuxdeploy_qt_sha256="${LINUXDEPLOY_QT_SHA256_AARCH64}"; linuxdeploy_plugin_appimage_sha256="${LINUXDEPLOY_PLUGIN_APPIMAGE_SHA256_AARCH64}" ;; \
        *) echo "Unsupported ARCH: ${ARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --show-error \
        --output /usr/local/bin/linuxdeploy \
        "https://github.com/linuxdeploy/linuxdeploy/releases/download/${LINUXDEPLOY_VERSION}/linuxdeploy-${ARCH}.AppImage"; \
    echo "${linuxdeploy_sha256}  /usr/local/bin/linuxdeploy" | sha256sum --check --strict; \
    curl --fail --location --show-error \
        --output /usr/local/bin/linuxdeploy-plugin-qt \
        "https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/${LINUXDEPLOY_QT_VERSION}/linuxdeploy-plugin-qt-${ARCH}.AppImage"; \
    echo "${linuxdeploy_qt_sha256}  /usr/local/bin/linuxdeploy-plugin-qt" | sha256sum --check --strict; \
    curl --fail --location --show-error \
        --output /usr/local/bin/linuxdeploy-plugin-appimage \
        "https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/${LINUXDEPLOY_PLUGIN_APPIMAGE_VERSION}/linuxdeploy-plugin-appimage-${ARCH}.AppImage"; \
    echo "${linuxdeploy_plugin_appimage_sha256}  /usr/local/bin/linuxdeploy-plugin-appimage" | sha256sum --check --strict; \
    chmod 0755 /usr/local/bin/linuxdeploy /usr/local/bin/linuxdeploy-plugin-qt /usr/local/bin/linuxdeploy-plugin-appimage

# The AppImage runtime must match the target architecture.
# package_linux.sh passes it to the plugin through LDAI_RUNTIME_FILE.
ARG APPIMAGE_RUNTIME_SHA256_X86_64=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
ARG APPIMAGE_RUNTIME_SHA256_AARCH64=00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444
RUN set -eux; \
    case "${ARCH}" in \
        x86_64)  runtime_sha256="${APPIMAGE_RUNTIME_SHA256_X86_64}" ;; \
        aarch64) runtime_sha256="${APPIMAGE_RUNTIME_SHA256_AARCH64}" ;; \
        *) echo "Unsupported ARCH: ${ARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --show-error \
        --output "${APPIMAGE_RUNTIME_FILE}" \
        "https://github.com/AppImage/type2-runtime/releases/download/${APPIMAGE_RUNTIME_VERSION}/runtime-${ARCH}"; \
    echo "${runtime_sha256}  ${APPIMAGE_RUNTIME_FILE}" | sha256sum --check --strict; \
    chmod 0644 "${APPIMAGE_RUNTIME_FILE}"

COPY reproducible-builds/download_hwi.sh reproducible-builds/hwi.lock.env /opt/hwi/
RUN bash /opt/hwi/download_hwi.sh linux "${ARCH}" /opt/hwi/hwi

# Publish the actual installed inputs alongside the release for verifiers.
# Keep this inventory outside the AppImage so it cannot affect its bytes.
RUN { \
        printf 'ubuntu_image=%s\nubuntu_snapshot=%s\n' "${UBUNTU_IMAGE}" "${UBUNTU_SNAPSHOT}"; \
        printf 'qt=%s\naqt=%s\n' "${QT_VERSION}" "${AQT_VERSION}"; \
        printf 'openssl=%s\n' "$(dpkg-query -W -f='${Version}' libssl-dev)"; \
        printf 'qtkeychain=%s\nolm=%s\n' "${QTKEYCHAIN_COMMIT}" "${OLM_COMMIT}"; \
        printf '\n[apt packages]\n'; \
        dpkg-query -W -f='${Package}\t${Architecture}\t${Version}\n' | LC_ALL=C sort; \
        printf '\n[python packages]\n'; \
        python3 -m pip freeze --all | LC_ALL=C sort; \
        printf '\n[hwi binary]\n'; \
        sha256sum /opt/hwi/hwi; \
        printf '\n[qt archives]\n'; \
        cat "/opt/qt-checksums/qt-${QT_VERSION}-linux-${ARCH}.sha256"; \
    } > /opt/builder-inputs.txt

WORKDIR /project

CMD ["bash", "reproducible-builds/build_linux.sh"]
